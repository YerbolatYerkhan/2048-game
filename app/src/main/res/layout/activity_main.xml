<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/settings_button_bg"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />

        <ImageButton
            android:id="@+id/btnLeaderboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/round_button_bg"
            android:padding="10dp"
            android:src="@drawable/ic_leaderboard"
            android:elevation="5dp"
            android:contentDescription="Leaderboard" />

        <ImageButton
            android:id="@+id/btnChallenges"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/round_button_bg"
            android:padding="10dp"
            android:src="@drawable/ic_lightning"
            android:elevation="5dp"
            android:contentDescription="Challenges" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/timerProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="56dp"
        android:layout_height="12dp"
        android:indeterminate="false"
        android:visibility="gone"
        android:max="100"
        android:progress="100"
        android:elevation="10dp"
        android:progressDrawable="@drawable/timer_progress_bg" />

    <LinearLayout
        android:id="@+id/heartsLayout"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/round_button_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="15dp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="24dp"
        android:translationY="-300dp"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_centerVertical="true"/>

            <ImageButton
                android:id="@+id/btnCloseSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound"
            android:textColor="#BBBBBB"
            android:textSize="14sp"/>

        <SeekBar
            android:id="@+id/seekSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="#EDC22E"
            android:thumbTint="#EDC22E"
            android:max="100"
            android:progress="70"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vibration"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginTop="20dp"/>

        <SeekBar
            android:id="@+id/seekVibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="#EDC22E"
            android:thumbTint="#EDC22E"
            android:max="100"
            android:progress="50"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFAF8EF"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="#776E65"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:id="@+id/finalScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#776E65"
            android:textSize="24sp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnTryAgain"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#8F7A66"
            android:text="Try Again"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:elevation="4dp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp" />

</FrameLayout>