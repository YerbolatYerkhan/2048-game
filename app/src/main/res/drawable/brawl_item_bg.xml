<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <solid android:color="#1A1A1A" /> <corners android:radius="16dp" />
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape>
            <gradient
                android:startColor="#333333"
                android:endColor="#2B2B2B"
                android:angle="270" />
            <stroke android:width="1.5dp" android:color="#4DFFFFFF" /> <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>