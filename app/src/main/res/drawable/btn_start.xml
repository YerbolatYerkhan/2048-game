<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow ↓ -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EDE8E2"/>
            <corners android:radius="22dp"/>

            <padding
                android:top="8dp"
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp" />

            <size
                android:width="0dp"
                android:height="0dp" />
        </shape>
    </item>

    <!-- Button surface -->
    <item android:bottom="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#F7F3EF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>

</layer-list>
