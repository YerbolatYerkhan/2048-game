<resources>
    <style name="StartButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/btn_text_light</item>
        <item name="android:background">@drawable/btn_start</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:fontFamily">@fonts/montserrat_semibold</item>
    </style>

    <style name="SecondaryButton" parent="StartButton">
        <item name="android:background">@drawable/btn_start_secondary</item>
        <item name="android:textColor">@color/btn_text_light</item>
    </style>

    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="SettingText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#5D5850</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OrangeButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">#F2A154</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="GameSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="trackTint">#CDC1B4</item>
        <item name="thumbTint">#8F7A66</item>
        <item name="colorControlActivated">#EDC22E</item>
    </style>
</resources>
