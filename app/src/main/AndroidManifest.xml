<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ereke.qadam2048">
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:forceDarkAllowed="false"
        android:allowBackup="true"
        android:icon="@drawable/logo_2048"
        android:roundIcon="@drawable/logo_2048"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ereke2048">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name="com.ereke.qadam2048.LeaderboardActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Leaderboard.Dialog" />

        <activity
            android:name="com.ereke.qadam2048.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.ereke.qadam2048.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>